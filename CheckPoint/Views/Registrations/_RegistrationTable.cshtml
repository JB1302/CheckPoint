@model IEnumerable<CheckPoint.Models.Registrations.Registration>

<div class="table-responsive">
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Fecha Registro</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var registration in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@registration.EventId">
                            @registration.EventId
                        </a>
                    </td>
                    <td>@registration.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@await Html.PartialAsync("~/Views/Registrations/_RegistrationStatusBadge.cshtml", registration.Status)</td>
                    <td>
                        @if (registration.Status == "Confirmed")
                        {
                            <form id="formCancelar-@registration.Id" asp-controller="Registrations" asp-action="Cancel" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@registration.EventId" />
                            </form>
                            <button type="button" class="btn btn-sm btn-danger"
                                    onclick="var m=document.getElementById('modalCancelar-@registration.Id');document.body.appendChild(m);bootstrap.Modal.getOrCreateInstance(m).show()">
                                Cancelar
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@foreach (var registration in Model)
{
    if (registration.Status == "Confirmed")
    {
        <div class="modal" id="modalCancelar-@registration.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-white">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title">Cancelar Registro</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        ¿Estás seguro de que deseas cancelar tu registro en este evento?
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
                        <button type="button" class="btn btn-danger"
                                onclick="document.getElementById('formCancelar-@registration.Id').submit()">
                            Sí, cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}