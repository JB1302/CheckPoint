@model CheckPoint.Models.Posts.Post

<div class="btn-group" role="group">
    <form method="post" asp-controller="Reactions" asp-action="Toggle" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="targetId" value="@Model.Id" />
        <input type="hidden" name="targetType" value="Post" />
        <input type="hidden" name="reactionType" value="Like" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        <button type="submit" class="btn btn-sm btn-outline-primary">
            👍 Like (@(Model.Reactions?.Count(r => r.ReactionType == "Like") ?? 0))
        </button>
    </form>
    <form method="post" asp-controller="Reactions" asp-action="Toggle" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="targetId" value="@Model.Id" />
        <input type="hidden" name="targetType" value="Post" />
        <input type="hidden" name="reactionType" value="Love" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        <button type="submit" class="btn btn-sm btn-outline-danger">
            ❤️ Love (@(Model.Reactions?.Count(r => r.ReactionType == "Love") ?? 0))
        </button>
    </form>
    <form method="post" asp-controller="Reactions" asp-action="Toggle" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="targetId" value="@Model.Id" />
        <input type="hidden" name="targetType" value="Post" />
        <input type="hidden" name="reactionType" value="Funny" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        <button type="submit" class="btn btn-sm btn-outline-warning">
            😂 Funny (@(Model.Reactions?.Count(r => r.ReactionType == "Funny") ?? 0))
        </button>
    </form>
</div>
