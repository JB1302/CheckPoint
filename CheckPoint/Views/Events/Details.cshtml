@model CheckPoint.ViewModels.EventDetailViewModel
@{
    ViewData["Title"] = Model.Title;

    var postsViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
    {
        ["EnableReactions"] = true,
        ["EnableEdit"] = true,
        ["EventId"] = Model.Id
    };
}

<div class="row">
    <div class="col-md-8">
        <h1>@Model.Title</h1>
        <p class="lead">@Model.Description</p>

        <div class="card mb-4 bg-dark text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Detalles del Evento</h5>
                    @if (User.IsInRole("Admin") || Model.IsUserOrganizer)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                            Editar Evento
                        </a>
                    }
                </div>
                <p><strong>Juego:</strong> @Model.GameName</p>
                <p><strong>Fecha y Hora:</strong> @Model.EventDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Ubicación:</strong> @Model.Location</p>
                <p><strong>Organizador:</strong> @Model.OrganizerName</p>
                <p><strong>Capacidad Máxima:</strong> @Model.MaxParticipants</p>
                <p><strong>Participantes Actuales:</strong> @Model.CurrentParticipants</p>
            </div>
        </div>

        @await Html.PartialAsync("_EventPostsSection", Model.Posts, postsViewData)
    </div>

    <div class="col-md-4">
        @await Html.PartialAsync("_EventDetailsSidebar", Model)
        @await Html.PartialAsync("_EventRegistrationsSection", Model.Registrations)
    </div>
</div>