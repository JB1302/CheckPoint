@model IEnumerable<CheckPoint.Models.Posts.Post>
@{
    ViewData["Title"] = $"Publicaciones - {ViewBag.EventTitle}";
}

<h1 class="text-white">Publicaciones: @ViewBag.EventTitle</h1>

<div class="row">
    <div class="col-md-12">

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="card mb-4 bg-dark text-white border-secondary">
                <div class="card-body">
                    <h5 class="mb-3">Nueva publicación</h5>

                    <form asp-controller="Posts" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <textarea name="content"
                                  class="form-control mb-2 text-white bg-dark border-secondary"
                                  rows="3"
                                  placeholder="Escribe una publicación..."></textarea>
                        <button type="submit" class="btn btn-primary">Publicar</button>
                    </form>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="posts-list">
                @foreach (var post in Model)
                {
                    var postViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                    {
                        ["EnableReactions"] = false,
                        ["EnableEdit"] = true
                    };

                    @await Html.PartialAsync("~/Views/Posts/_PostCard.cshtml", post, postViewData)
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                No hay publicaciones todavía.
            </div>
        }
    </div>
</div>